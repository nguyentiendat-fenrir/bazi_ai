# Copy to .env locally; leave secrets empty until generated outside Git.
# dev | test | production. Production refuses to start without strong secrets.
APP_ENV=dev
LOG_LEVEL=INFO
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bazi
POSTGRES_USER=bazi
POSTGRES_PASSWORD=
# API/worker login: member of bazi_runtime, subject to row-level security.
# Create with: python -m backend.app.cli create-runtime-login
POSTGRES_APP_USER=bazi_app
POSTGRES_APP_PASSWORD=
REDIS_URL=redis://redis:6379/0
# Production: at least 32 random characters each.
SESSION_SIGNING_KEY=
FIELD_ENCRYPTION_KEY=

# Object storage: local volume (default) or S3-compatible. Containers use /data/objects.
STORAGE_BACKEND=local
STORAGE_ROOT=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Absolute source directory on Ubuntu; empty uses repository inputs/books.
BOOKS_DIR=
# Existing Gemma service: configuration contract for T038, not connected yet.
# Existing llama.cpp server-cuda; base URL must end in /v1.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Separate embedding model/profile, selected after retrieval evaluation.
EMBEDDING_MODEL=
