# Copy to .env locally; leave secrets empty until generated outside Git.
# dev | test | production. Production refuses to start without strong secrets.
APP_ENV=dev
LOG_LEVEL=INFO
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bazi
POSTGRES_USER=bazi
POSTGRES_PASSWORD=
# API/worker login: member of bazi_runtime, subject to row-level security.
# Create with: python -m backend.app.cli create-runtime-login
POSTGRES_APP_USER=bazi_app
POSTGRES_APP_PASSWORD=
REDIS_URL=redis://redis:6379/0
# Production: at least 32 random characters each.
SESSION_SIGNING_KEY=
FIELD_ENCRYPTION_KEY=
# Encrypts backup archives (>= 32 characters). Keep a copy offline: without it no backup
# made with it can be restored. Leave empty only if backups go to encrypted storage.
BACKUP_ENCRYPTION_KEY=

# Object storage: local volume (default) or S3-compatible. Containers use /data/objects.
STORAGE_BACKEND=local
STORAGE_ROOT=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Absolute source directory on Ubuntu; empty uses repository inputs/books.
BOOKS_DIR=
# LLM: the Qwen3-8B vLLM container on this host (port 8000, served name qwen3-8b), reached
# from the api/worker/reasoner containers through host-gateway. Base URL must end in /v1.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL=qwen3-8b
LLM_API_KEY=
# Separate embedding model/profile, selected after retrieval evaluation.
EMBEDDING_MODEL=

# RAG pilot (backend/app/rag). Hybrid fusion of min-max normalised scores per query.
RAG_DENSE_WEIGHT=0.8
RAG_SPARSE_WEIGHT=0.2
RAG_DENSE_CANDIDATES=50
RAG_SPARSE_CANDIDATES=50
# Reranker on CPU: ~0.5 s per candidate on this host; 0 turns it off.
RAG_RERANK_DEPTH=10
RAG_CONTEXT_TOKENS=9000
RAG_ANSWER_TOKENS=1500
RAG_THINKING=false
RAG_CPU_THREADS=16
# Tests and machines without the models: false keeps /ask degraded and chat on the old path.
RAG_LOAD_MODELS=true

# Judging page (/judge): Argon2 hash of the shared judge password, never the password.
# Create with: docker compose ... run --rm api python -m backend.app.cli judge-password
JUDGE_PASSWORD_HASH=

# Sub-path the UI and API are published under, e.g. /bazi behind a Tailscale Funnel mount
# (`tailscale funnel --set-path=/bazi 3000`); empty serves from "/". Rebuild the frontend
# image after changing it (it is fixed at build time).
PUBLIC_BASE_PATH=
