#!/usr/bin/env python3
"""Windows development / Ubuntu deployment preflight, corpus inspection, backup/restore.

No secret value is printed. Later task commands are added only with their
implementation and tests, not as success-shaped stubs.

    python3 scripts/dev backup --dest /srv/bazi-backups
    python3 scripts/dev restore-preflight --manifest /srv/bazi-backups/<name>/manifest.json
    python3 scripts/dev restore --manifest /srv/bazi-backups/<name>/manifest.json --confirm <name>
    python3 scripts/dev deletion-ledger --dest /srv/bazi-backups   # before restoring an old backup

Backup and restore run the application image (pg_dump/pg_restore 17) through Docker
Compose. A restore always goes into a separate Compose project with new volumes; the
running system is never overwritten (docs/12).
"""
from __future__ import annotations

import argparse
import ctypes
import json
import os
from pathlib import Path
import platform
import shutil
import socket
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
REQUIRED_SECRETS = ('POSTGRES_PASSWORD', 'SESSION_SIGNING_KEY', 'FIELD_ENCRYPTION_KEY')
DEPENDENCY_HOSTS = ('pypi.org', 'registry-1.docker.io')


def command_ok(*args: str) -> bool:
    try:
        result = subprocess.run(args, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, timeout=8, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def docker_executable() -> str | None:
    executable = shutil.which('docker')
    if executable:
        return executable
    if platform.system() == 'Windows':
        candidate = Path(os.environ.get('ProgramFiles', 'C:/Program Files')) / 'Docker/Docker/resources/bin/docker.exe'
        if candidate.is_file():
            return str(candidate)
    return None


def memory_bytes() -> int | None:
    if os.name == 'nt':
        class MemoryStatus(ctypes.Structure):
            _fields_ = [('length', ctypes.c_ulong), ('load', ctypes.c_ulong),
                        ('total_physical', ctypes.c_ulonglong),
                        ('available_physical', ctypes.c_ulonglong),
                        ('total_page', ctypes.c_ulonglong),
                        ('available_page', ctypes.c_ulonglong),
                        ('total_virtual', ctypes.c_ulonglong),
                        ('available_virtual', ctypes.c_ulonglong),
                        ('available_extended', ctypes.c_ulonglong)]
        status = MemoryStatus()
        status.length = ctypes.sizeof(status)
        return status.total_physical if ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(status)) else None
    try:
        for line in Path('/proc/meminfo').read_text().splitlines():
            if line.startswith('MemTotal:'):
                return int(line.split()[1]) * 1024
    except (OSError, ValueError):
        pass
    return None


def read_env_presence(path: Path) -> dict[str, bool]:
    values: dict[str, str] = {}
    try:
        for line in path.read_text(encoding='utf-8').splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith('#') or '=' not in stripped:
                continue
            key, value = stripped.split('=', 1)
            values[key.strip()] = value.strip().strip('"\'')
    except OSError:
        pass
    # Report keys and presence only. Never put values in diagnostics.
    return {key: bool(values.get(key)) for key in REQUIRED_SECRETS}


def dependency_reachable(host: str) -> bool:
    try:
        with socket.create_connection((host, 443), timeout=3):
            return True
    except OSError:
        return False


def doctor(root: Path = ROOT, target: str = 'dev') -> dict:
    if target not in ('dev', 'deploy'):
        raise ValueError('Unknown doctor target')
    checks: dict[str, dict] = {}
    deploy = target == 'deploy'

    def add(name: str, ok: bool, detail: str, essential: bool = True) -> None:
        checks[name] = {'ok': ok, 'essential': essential, 'detail': detail}

    is_windows = platform.system() == 'Windows'
    add('linux_environment', platform.system() == 'Linux',
        'Linux required on deployment host; Windows supported for development', essential=deploy)
    on_mounted_windows_drive = (not is_windows and
                                len(root.resolve().parts) >= 3 and
                                root.resolve().parts[1] == 'mnt' and
                                len(root.resolve().parts[2]) == 1)
    add('linux_filesystem', not is_windows and not on_mounted_windows_drive,
        'deployment repository must be on a Linux filesystem', essential=deploy)
    add('python_version', sys.version_info[:2] == (3, 12),
        'Python 3.12 required for local development; deployment uses the pinned container', essential=not deploy)

    docker = docker_executable()
    add('docker_cli', bool(docker), 'Docker executable found' if docker else 'Docker executable missing', essential=deploy)
    add('docker_compose', bool(docker and command_ok(docker, 'compose', 'version')),
        'Docker Compose plugin required', essential=deploy)
    add('docker_daemon', bool(docker and command_ok(docker, 'info')),
        'Docker daemon must answer docker info', essential=deploy)

    mem = memory_bytes()
    add('memory', mem is not None and mem >= 16 * 1024**3,
        f'{round(mem / 1024**3, 1)} GiB detected; 16 GiB baseline excluding Gemma' if mem else 'physical memory unavailable', essential=deploy)
    disk = shutil.disk_usage(root)
    minimum = max(10 * 1024**3, int(disk.total * 0.15))
    add('disk', disk.free >= minimum,
        f'{round(disk.free / 1024**3, 1)} GiB free; {round(minimum / 1024**3, 1)} GiB required', essential=deploy)

    template = root / '.env.example'
    env = root / '.env'
    add('env_template', template.is_file(), '.env.example must exist')
    add('env_file', env.is_file(), '.env must be created locally and ignored by Git', essential=deploy)
    for key, present in read_env_presence(env).items():
        add('env_' + key.lower(), present, key + ' must be set locally; value never printed', essential=deploy and key == 'POSTGRES_PASSWORD')

    add('compose_file', (root / 'infra/compose.yaml').is_file(), 'infra/compose.yaml must exist')
    add('python_lock', (root / 'uv.lock').is_file(), 'uv.lock must exist')

    tools_dir = root / '.tools'
    try:
        tools_dir.mkdir(exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='doctor-', dir=tools_dir):
            volume_write = True
    except OSError:
        volume_write = False
    add('local_write', volume_write, 'ignored .tools directory writable (host only)')
    for host in DEPENDENCY_HOSTS:
        add('network_' + host.replace('.', '_').replace('-', '_'), dependency_reachable(host),
            'TLS port reachable for dependency download: ' + host, essential=False)

    essential_failures = sorted(name for name, item in checks.items()
                                if item['essential'] and not item['ok'])
    degraded = sorted(name for name, item in checks.items()
                      if not item['essential'] and not item['ok'])
    return {'status': 'READY' if not essential_failures else 'BLOCKED', 'target': target,
            'scope': 'preflight only; not application or Gemma readiness',
            'essential_failures': essential_failures, 'degraded': degraded,
            'checks': checks}


LIVE_PROJECT = 'bazi-ai'      # name: in infra/compose.yaml
RESTORE_PROJECT = 'bazi-restore'


ENV_FILE = ROOT / '.env'


def compose(docker: str, project: str | None, *args: str, env_file: Path = ENV_FILE) -> list[str]:
    command = [docker, 'compose', '--env-file', str(env_file), '-f',
               str(ROOT / 'infra/compose.yaml')]
    return command + (['-p', project] if project else []) + list(args)


def cli(*args: str) -> list[str]:
    return ['python', '-m', 'backend.app.cli', *args]


def backup_commands(docker: str, dest: Path, name: str | None, project: str | None = None,
                    env_file: Path = ENV_FILE) -> list[list[str]]:
    """The worker container has the objects volume and the database network."""
    args = ['--dest', '/backups'] + (['--name', name] if name else [])
    return [compose(docker, project, 'run', '--rm', '-T', '-v', f'{dest.resolve()}:/backups',
                    'worker', *cli('backup', *args), env_file=env_file)]


APP_IMAGE = 'bazi-ai-app:local'


def preflight_commands(docker: str, manifest: Path) -> list[list[str]]:
    # Read-only check: no Compose project, network, volume or .env is involved.
    return [[docker, 'run', '--rm', '--network', 'none', '--read-only', '-v',
             f'{manifest.resolve().parent}:/backup:ro', APP_IMAGE,
             *cli('restore-preflight', '--manifest', '/backup/manifest.json')]]


def ledger_commands(docker: str, dest: Path, project: str | None = None,
                    env_file: Path = ENV_FILE) -> list[list[str]]:
    """Erasures of the live system, so a restore of an older backup can apply them again."""
    return [compose(docker, project, 'run', '--rm', '-T', '-v', f'{dest.resolve()}:/backups',
                    'worker', *cli('deletion-ledger', '--out', '/backups/deletion-ledger.json'),
                    env_file=env_file)]


def restore_commands(docker: str, manifest: Path, confirm: str, project: str,
                     env_file: Path = ENV_FILE, ledger: Path | None = None) -> list[list[str]]:
    if project == LIVE_PROJECT:
        raise SystemExit(f'Restore into a new project with new volumes, not {LIVE_PROJECT}.')
    folder = manifest.resolve().parent
    mounts = ['-v', f'{folder}:/backup:ro']
    extra: list[str] = []
    if ledger is not None:
        mounts += ['-v', f'{ledger.resolve()}:/ledger.json:ro']
        extra = ['--deletion-ledger', '/ledger.json']
    return [compose(docker, project, 'up', '-d', '--wait', 'postgres', 'redis', env_file=env_file),
            compose(docker, project, 'run', '--rm', '-T', *mounts, 'worker',
                    *cli('restore', '--manifest', '/backup/manifest.json', '--confirm', confirm,
                         *extra),
                    env_file=env_file),
            compose(docker, project, 'run', '--rm', '-T', 'worker', *cli('create-runtime-login'),
                    env_file=env_file)]


def run_all(commands: list[list[str]]) -> int:
    for command in commands:
        result = subprocess.run(command, cwd=ROOT, check=False)
        if result.returncode != 0:
            return result.returncode
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    check = commands.add_parser('doctor')
    check.add_argument('--target', choices=('dev', 'deploy'), default='dev')
    inspect = commands.add_parser('inspect-books')
    inspect.add_argument('directory', nargs='?', type=Path, default=ROOT / 'inputs/books')
    inspect.add_argument('--sample-chars', type=int, choices=range(0, 2001), default=0, metavar='0..2000')
    back = commands.add_parser('backup', help='consistent backup into a host directory')
    back.add_argument('--dest', type=Path, required=True,
                      help='encrypted storage, writable by uid 10001; outside the volumes')
    back.add_argument('--name')
    back.add_argument('--project', help='Compose project to back up (default: the live one)')
    pre = commands.add_parser('restore-preflight', help='verify a backup, change nothing')
    pre.add_argument('--manifest', type=Path, required=True)
    rest = commands.add_parser('restore', help='restore into a NEW Compose project and volumes')
    rest.add_argument('--manifest', type=Path, required=True)
    rest.add_argument('--confirm', required=True, help='the backup name, typed again')
    rest.add_argument('--project', default=RESTORE_PROJECT)
    rest.add_argument('--deletion-ledger', type=Path,
                      help='from `deletion-ledger`: erasures after the backup are applied again')
    led = commands.add_parser('deletion-ledger', help='export erasures of the live system')
    led.add_argument('--dest', type=Path, required=True)
    led.add_argument('--project', help='Compose project (default: the live one)')
    for sub in (back, rest, led):
        sub.add_argument('--env-file', type=Path, default=ENV_FILE)
    args = parser.parse_args(argv)
    if args.command in ('backup', 'restore-preflight', 'restore', 'deletion-ledger'):
        docker = docker_executable()
        if not docker:
            print('Docker is required for backup/restore.', file=sys.stderr)
            return 2
        if args.command == 'backup':
            return run_all(backup_commands(docker, args.dest, args.name, args.project,
                                           args.env_file))
        if args.command == 'restore-preflight':
            return run_all(preflight_commands(docker, args.manifest))
        if args.command == 'deletion-ledger':
            return run_all(ledger_commands(docker, args.dest, args.project, args.env_file))
        up, restore, login = restore_commands(docker, args.manifest, args.confirm, args.project,
                                              args.env_file, args.deletion_ledger)
        code = run_all([up, restore])
        if code:
            return code
        if run_all([login]):
            # The containers read .env through env_file; the restore itself is complete.
            print(f'Restored, but the API login role was not created: set POSTGRES_APP_USER and'
                  f' POSTGRES_APP_PASSWORD in .env, then run: docker compose --env-file .env -f'
                  f' infra/compose.yaml -p {args.project} run --rm worker python -m'
                  f' backend.app.cli create-runtime-login', file=sys.stderr)
            return 3
        print(f'Restored into project {args.project!r} (its own volumes). Check it on another'
              f' port: GATEWAY_PORT=3001 docker compose --env-file .env -f infra/compose.yaml'
              f' -p {args.project} --profile app up -d. Switch only after checks pass; keep'
              f' the old volumes until the restored system has run a while.')
        return 0
    if args.command == 'doctor':
        result = doctor(target=args.target)
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return 0 if result['status'] == 'READY' else 1
    if args.command == 'inspect-books':
        from inspect_corpus import main as inspect_main
        return inspect_main([str(args.directory), '--sample-chars', str(args.sample_chars)])
    return 2


if __name__ == '__main__':
    sys.exit(main())
